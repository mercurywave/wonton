{
  "applicationId": "com.wonton.agent",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/vite-src/dist/",
  "url": "/",
  "port": 3219,
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "filesystem.*",
    "os.showFolderDialog",
    "os.open",
    "os.execCommand",
    "computer.getOSInfo",
    "os.getEnv"
  ],
  "singlePageServe": true,
  "tokenSecurity": "one-time",
  "modes": {
    "window": {
      "title": "Wonton",
      "width": 800,
      "height": 500,
      "minWidth": 400,
      "minHeight": 200,
      "icon": "/vite-src/public/takeout.png",
      "enableInspector": true
    }
  },
  "cli": {
    "binaryName": "Wonton",
    "resourcesPath": "/vite-src/dist/",
    "extensionsPath": "/extensions/",
    "frontendLibrary": {
      "patchFile": "/vite-src/index.html",
      "devUrl": "http://localhost:5173",
      "projectPath": "/vite-src/",
      "initCommand": "npm install",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build"
    },
    "binaryVersion": "6.7.0"
  }
}