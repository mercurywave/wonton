{
  "application": {
    "id": "com.wonton.agent",
    "version": "1.0.0",
    "title": "Wonton",
    "description": "Local-first AI coding harness",
    "main": "out/index.html",
    "homePage": "out/index.html",
    "enableAppStatus": true,
    "enableSandbox": true,
    "enableNativeAPI": true,
    "enableNativeCrossPaste": true,
    "url": "http://localhost:5173",
    "enableServer": true,
    "serverPort": 5173,
    "documentRoot": "out",
    "window": {
      "width": 1100,
      "height": 750,
      "minWidth": 800,
      "minHeight": 500,
      "center": true,
      "hideWindowChrome": false,
      "borderless": false,
      "resizable": true,
      "showSystemTray": false,
      "systemTrayWidth": 600,
      "icon": "assets/icon.png"
    },
    "cliArgs": [],
    "nativeAllowList": [
      "app.*",
      "fileManager.*",
      "window.*"
    ],
    "nativeDenyList": [
      "fileManager.moveDirectory",
      "fileManager.moveFile"
    ]
  },
  "platforms": {
    "windows": {
      "binaryName": "wonton",
      "icon": "assets/icon.png"
    }
  },
  "features": {
    "localapi": {
      "allowUploadDownload": true,
      "allowProcessManagement": false,
      "allowReadAppDebugInfo": true,
      "allowReadAppConfig": true,
      "allowWriteAppDebugInfo": true,
      "allowRestartAppDaemon": false,
      "allowEvaluateRequest": false
    },
    "resources": {
      "path": "resources",
      "zipExtractPath": ""
    }
  },
  "logging": {
    "level": "debug",
    "path": "logs"
  }
}
