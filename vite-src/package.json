{
	"name": "myapp",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"main": "out/electron/main.js",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"build:electron": "tsc -b electron/tsconfig.json && vite build && tsc -p electron/tsconfig.main.json",
		"lint": "eslint .",
		"preview": "vite preview",
		"electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.main.json --watch --noEmit\" \"nodemon --watch electron --exec electron .\"",
		"electron:build": "tsc -b && vite build && tsc -p electron/tsconfig.main.json && electron-builder"
	},
	"dependencies": {
		"lucide-react": "^1.11.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@electron-toolkit/preload": "^3.0.0",
		"@electron-toolkit/tsconfig": "^1.0.1",
		"@eslint/js": "^9.9.0",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react-swc": "^4.2.0",
		"concurrently": "^9.1.0",
		"electron": "^33.3.0",
		"electron-builder": "^25.1.8",
		"eslint": "^9.9.0",
		"eslint-plugin-react-hooks": "^7.0.0",
		"eslint-plugin-react-refresh": "^0.4.26",
		"globals": "^15.9.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.53.0",
		"vite": "^7.3.0",
		"wait-on": "^8.0.1",
		"nodemon": "^3.1.7"
	},
	"engines": {
		"node": ">=22"
	},
	"build": {
		"appId": "com.wonton.agent",
		"productName": "Wonton",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"out/electron/**/*"
		],
		"extraMetadata": {
			"main": "out/electron/main.js"
		},
		"win": {
			"target": "nsis",
			"icon": "public/takeout.png"
		},
		"mac": {
			"target": "dmg",
			"icon": "public/takeout.png"
		},
		"linux": {
			"target": "AppImage",
			"icon": "public/takeout.png"
		}
	}
}
